{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard-parsed.ps1"
          }
        ]
      }
    ]
  }
}
