# ===== フォレンジックスキル設定 =====
# .env にコピーして使う(setup.ps1 が自動で作成)。
# ".\" で始まるパスはプロジェクトフォルダからの相対パス。

# --- CDIR-C ---
CDIRC_PATH=.\tools\cdir-collector\cdir-collector.exe

# --- Eric Zimmerman Tools ---
MFTECMD=.\tools\ez\MFTECmd.exe
PECMD=.\tools\ez\PECmd.exe
EVTXECMD=.\tools\ez\EvtxeCmd\EvtxECmd.exe
RECMD=.\tools\ez\RECmd\RECmd.exe
RECMD_BATCH=.\tools\ez\RECmd\BatchExamples\Kroll_Batch.reb
AMCACHEPARSER=.\tools\ez\AmcacheParser.exe
APPCOMPATCACHEPARSER=.\tools\ez\AppCompatCacheParser.exe
SBECMD=.\tools\ez\SBECmd.exe
SRUMECMD=.\tools\ez\SrumECmd.exe

# --- NirSoft ---
BROWSERHISTORYVIEW=.\tools\nirsoft\BrowsingHistoryView.exe
BROWSERDOWNLOADSVIEW=.\tools\nirsoft\BrowserDownloadsView.exe

# --- 7-Zip(view-vhdx 用)---
SEVENZIP=.\tools\7zip\7z.exe

# --- Python(補助解析スクリプト用)---
# setup.ps1 が .venv を作成し requirements.txt を入れる。
# EZ Tools でカバーしない解析(ブラウザSQLite/PDF/SAMハッシュ等)はこの Python で実行する。
PYTHON=.\.venv\Scripts\python.exe

# --- 作業フォルダ ---
# プロジェクトフォルダの外に置く(Git管理外・フックの誤検知防止)
COLLECT_DIR=C:\cases\collected
PARSED_DIR=C:\cases\parsed
